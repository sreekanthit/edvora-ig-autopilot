# --- Instagram API with Instagram Login (graph.instagram.com) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
IG_GRAPH_HOST=https://graph.instagram.com
# Public base URL where files in ./media are served (needed for carousel images).
# Example (public repo): https://raw.githubusercontent.com/<you>/<repo>/main/media
PUBLIC_BASE_URL=
# --- Only for `generate` (drafting captions/scripts with Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
